# Scout Mini Quickstart configuration
ROS_DISTRO=humble
WORKSPACE_DIR=$HOME/scout_ws
SOURCE_REPO=https://github.com/Jsm9902/scout_mini.git
SOURCE_BRANCH=main

CAN_INTERFACE=can0
CAN_BITRATE=500000

WEB_SERVER_PORT=8000
ROSBRIDGE_PORT=9090
VIDEO_SERVER_PORT=8080

# Set to 1 to install optional patrol/exploration-related dependencies.
INSTALL_FULL_FEATURES=0
