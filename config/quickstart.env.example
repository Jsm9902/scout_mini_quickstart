# Scout Mini Quickstart configuration
ROS_DISTRO=humble
WORKSPACE_DIR=$HOME/scout_ws
SOURCE_REPO=https://github.com/Jsm9902/scout_mini.git
SOURCE_BRANCH=main

CAN_INTERFACE=can0
CAN_BITRATE=500000

WEB_SERVER_PORT=8000
ROSBRIDGE_PORT=9090
VIDEO_SERVER_PORT=8080

# 1: 기존 workspace/src를 날짜 폴더로 백업한 뒤 새로 설치
# 0: 기존 src가 있으면 설치 중단
BACKUP_EXISTING_SRC=1
