# Scout Mini Quickstart runtime configuration
ROS_DISTRO=humble
WORKSPACE_DIR="$HOME/scout_ws"
SOURCE_REPO="https://github.com/Jsm9902/scout_mini.git"
SOURCE_BRANCH="main"

# Workspace/source policy: update | backup | abort
SOURCE_POLICY=update
BUILD_JOBS=2

# CAN
CAN_INTERFACE=can0
CAN_BITRATE=500000
ENABLE_CAN_SERVICE=1

# ROS networking (single robot on local LAN)
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Web ports used by the existing scout_web_monitor package
WEB_SERVER_PORT=8000
ROSBRIDGE_PORT=9090
VIDEO_SERVER_PORT=8080

# Install optional camera drivers. Set 1 only for attached hardware.
INSTALL_REALSENSE=0
INSTALL_V4L2_CAMERA=1

# Safety: installation never auto-starts robot motion.
RUN_HARDWARE_SMOKE_TEST=0
