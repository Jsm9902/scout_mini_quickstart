# Scout Mini Quickstart configuration
ROS_DISTRO=humble
WORKSPACE_DIR="$HOME/scout_ws"
SOURCE_REPOSITORY="https://github.com/Jsm9902/scout_mini.git"
SOURCE_BRANCH="main"
SOURCE_POLICY="backup"   # backup | update | abort

CAN_INTERFACE="can0"
CAN_BITRATE="500000"
CAN_RESTART_MS="100"
CAN_TXQUEUELEN="1000"
ENABLE_CAN_SERVICE="1"

ENABLE_VELODYNE="1"
ENABLE_REALSENSE="1"
ENABLE_WEB="1"
ENABLE_EXPLORATION="0"

ROS_DOMAIN_ID="0"
ROS_LOCALHOST_ONLY="0"
RMW_IMPLEMENTATION="rmw_fastrtps_cpp"

ROSBRIDGE_PORT="9090"
VIDEO_SERVER_PORT="8080"
WEB_SERVER_PORT="8000"

BUILD_JOBS="2"
MIN_DISK_GB="15"
INSTALL_OPENSSH="1"
INSTALL_TERMINATOR="0"
